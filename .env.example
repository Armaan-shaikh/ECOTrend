# EcoTrend Production Environment Variables Template
# Copy to .env and configure environment-specific values before deployment

# PostgreSQL / TimescaleDB Configuration
POSTGRES_DB=ecotrend
POSTGRES_USER=ecotrend_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300

# Application Ports & Service URLs
API_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=postgresql+psycopg2://ecotrend_user:your_secure_postgres_password_here@localhost:5432/ecotrend
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
